# 网络
# 0.0.0.0 允许同一局域网 / 手机访问；只想本机用可改成 127.0.0.1
HOST=0.0.0.0
PORT=8000
# 开放到局域网或公网时强烈建议设置；留空表示不鉴权
ACCESS_TOKEN=
# 允许跨域的来源，逗号分隔；* 表示全部
CORS_ORIGINS=*

# 默认（留空）为 mock 模式：不需要任何 API Key 即可跑通完整流程。
# 填入 OpenAI 兼容接口后自动切换为真实模型。
# 也可以在网页左侧「模型供应商」里配置，网页配置优先于这里。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 单次模型请求超时（秒）。推理模型建议 300-600；也可在网页供应商里单独设置
LLM_TIMEOUT=300

# 透明度计费（美元 / 百万 token），仅用于成本估算
LLM_PRICE_IN=0.15
LLM_PRICE_OUT=0.60

# 如果服务器需要通过代理访问模型（也可在网页供应商高级里单独配置）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Web Search：三选一；都不填则使用 DuckDuckGo HTML（可能被限流）
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=https://searx.example.com

# 本地工作区：Agent 只能读写这个目录内的文件；默认 mvp/data/workspace。
# 启动后也可以在网页「设置 → 工作区」里修改，无需重启。
# WORKSPACE_DIR=
# 是否允许 Agent 在工作区执行本地命令。默认开启；设为 0 关闭。
ENABLE_SHELL=1
# 命令审批：1 表示每条 run_command 都要在网页里人工批准后才能执行
COMMAND_APPROVAL=1
APPROVAL_TIMEOUT=300
SHELL_TIMEOUT=60
COMMAND_MAX_OUTPUT=12000

# 调度与预算
MAX_CONCURRENCY=4
MAX_STEPS_PER_TASK=10
MAX_TOTAL_STEPS=60
MAX_TOKENS=2000000
MAX_USD=1.0
DEADLINE_SEC=3600

# 数据目录（默认 mvp/data）
# DATA_DIR=
